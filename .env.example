# No values are required. Bind to localhost only: this is a single-workstation prototype.
# Public browser demo: no database or AI key needed. See BROWSER_DEMO.md.
# Set in Vercel Production/Preview settings; VERCEL=1 also selects it.
# BATCHVISTA_MODE=browser
# Optional cloud inference: disabled unless all settings and per-inspection consent exist.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Set only for a project WITHOUT billing enabled; the app cannot verify your billing account.
GEMINI_FREE_TIER_ACK=false
# Database and images default to ./data. Never place this directory under public/.
# BATCHVISTA_DATA_DIR=
# Optional exact trusted HTTPS origin for phone access (no trailing slash).
# First create a named administrator in Settings on localhost. See PHONE_SETUP.md.
# BATCHVISTA_ORIGIN=https://192.168.1.25:8443
